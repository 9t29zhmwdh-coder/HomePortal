# Folder on the host that holds portal.yaml and photos/
DATA_PATH=/volume1/docker/home-portal

# Timezone
TZ=Europe/Zurich

# Optional: bind the portal to one network interface instead of all (default 0.0.0.0)
# BIND_ADDRESS=192.168.1.10

# Optional: set to 1 when a TLS proxy sits in front but does not send X-Forwarded-Proto.
# Forces the Secure flag on the session cookie and sends HSTS.
# HOME_PORTAL_SECURE_COOKIES=1
